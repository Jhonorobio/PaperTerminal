# ── Secrets ──────────────────────────────────────────────────────────────────
# Privy customer refresh token from a fomo.family session (1h access tokens are
# minted from it). Expires when you log out of fomo.family.
FOMO_REFRESH_TOKEN=

# Photon app cookie (_photon_ta). Leave empty to use the built-in one; set it
# when the app rotates the cookie.
PHOTON_TA=

# Expo push: optional. Without it pushes still work, but with lower priority.
EXPO_ACCESS_TOKEN=

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=8787
# Where the JSON stores live. On Railway, mount a volume at /data.
DATA_DIR=./data
