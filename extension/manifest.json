{
  "manifest_version": 3,
  "name": "Paper Terminal — Monitor",
  "version": "1.0.0",
  "description": "Monitor de escritorio de FOMO, Photon, Track y Pump Trend., con las mismas alertas que la app del teléfono. Solo lectura.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "notifications", "sidePanel", "alarms"],
  "host_permissions": ["https://paperterminal-production.up.railway.app/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Paper Terminal — Monitor" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
